# =============================================================================
# PI Agent — Multistage Ubuntu 26.04 (Linux kernel 7.x) + Rust tools
# Hardened · Minimal · ARM64 (Apple Silicon / M4)
#
# Stage 1 — builder  : Ubuntu 26.04 + Rust toolchain → compila herramientas
# Stage 2 — runtime  : Ubuntu 26.04 + PI SDK         → local LLM backend
#
# Por qué Ubuntu 26.04 en vez de Wolfi:
#   PI agents necesitan un kernel Linux 7.x (mejoras de io_uring y memory
#   accounting). Ubuntu 26.04 LTS es el LTS que ships con kernel 7.x en
#   imagen ARM64, y mantiene un buen footprint con apt --no-install-recommends.
#
# Por qué un Dockerfile separado en vez de extender Dockerfile.wolfi:
#   Open/Closed Principle — Dockerfile.wolfi sigue sin tocar para los
#   agentes Claude. PI agents son una extensión paralela, no una
#   modificación del flujo existente.
#
# Backend LLM:
#   El contenedor NO embarca un modelo. Se conecta al `mlx_lm.server`
#   corriendo en el host vía host.containers.internal:8080 (gestionado
#   por `uv run iac server start` desde /iac).
#   ⚠️ El modelo Gemma-4-26b + 6GB de prompt cache deja poco margen de
#   RAM. El Makefile aplica MAX_PI_AGENTS=1 por defecto.
# =============================================================================


# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM --platform=linux/arm64 ubuntu:26.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/root \
    PATH="/root/.cargo/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        pkg-config \
        libssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
       | sh -s -- -y --default-toolchain stable --no-modify-path \
    && cargo install \
        ripgrep \
        fd-find \
        bat \
        eza \
        du-dust \
        procs \
        bottom \
    && rm -rf /root/.cargo/registry /root/.cargo/git


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM --platform=linux/arm64 ubuntu:26.04 AS runtime

LABEL maintainer="pi-agent" \
      description="Hardened PI agent — Ubuntu 26.04 + local mlx_lm backend" \
      org.opencontainers.image.base.name="ubuntu:26.04"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm-256color \
    PATH="/root/.local/bin:/usr/local/bin:$PATH" \
    BAT_PAGER="" \
    BAT_STYLE="numbers,changes,header" \
    PI_BASE_URL=http://host.containers.internal:8080/v1 \
    PI_DISABLE_AUTOUPDATE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        curl \
        wget \
        git \
        git-lfs \
        openssh-client \
        ca-certificates \
        jq \
        unzip \
        gzip \
        tmux \
        nodejs \
        npm \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/.cargo/bin/rg     /usr/local/bin/rg
COPY --from=builder /root/.cargo/bin/fd     /usr/local/bin/fd
COPY --from=builder /root/.cargo/bin/bat    /usr/local/bin/bat
COPY --from=builder /root/.cargo/bin/eza    /usr/local/bin/eza
COPY --from=builder /root/.cargo/bin/dust   /usr/local/bin/dust
COPY --from=builder /root/.cargo/bin/procs  /usr/local/bin/procs
COPY --from=builder /root/.cargo/bin/btm    /usr/local/bin/btm

# PI SDK — verify exact package name on https://pi.dev/
# Default placeholder: `pi-ai` PyPI package providing the `pi` CLI.
# Override at build time with: --build-arg PI_PACKAGE=<alt-name>
ARG PI_PACKAGE=pi-ai
RUN pip3 install --break-system-packages --no-cache-dir "${PI_PACKAGE}"

# Aliases Rust
RUN printf '%s\n' \
    "alias grep='rg --smart-case --follow'" \
    "alias find='fd --follow'" \
    "alias cat='bat --paging=never'" \
    "alias ls='eza'" \
    "alias ll='eza -la --git'" \
    "alias la='eza -la'" \
    "alias lt='eza --tree --level=2'" \
    "alias du='dust'" \
    "alias ps='procs'" \
    "alias top='btm'" \
    > /etc/profile.d/rust-aliases.sh

RUN echo 'source /etc/profile.d/rust-aliases.sh' >> /root/.bashrc \
    && echo 'source /etc/profile.d/rust-aliases.sh' >> /root/.profile

# Git config base (root)
RUN git config --global init.defaultBranch main \
    && git config --global core.editor "true" \
    && git config --global advice.detachedHead false

# Non-root user for headless PI agents (parity with Dockerfile.wolfi)
RUN groupadd --system agent \
    && useradd --system --gid agent --home-dir /home/agent --shell /bin/bash agent \
    && mkdir -p /home/agent \
    && chown -R agent:agent /home/agent

# Git config for agent user
RUN printf '[init]\n\tdefaultBranch = main\n[core]\n\teditor = true\n[advice]\n\tdetachedHead = false\n[user]\n\temail = agent@container\n\tname = PI Agent\n' \
    > /home/agent/.gitconfig \
    && chown agent:agent /home/agent/.gitconfig

# su-exec equivalent (same Python shim as Dockerfile.wolfi)
# Drops to the specified user via os.setuid/setgid then exec.
RUN printf '#!/usr/bin/env python3\nimport os, sys, pwd\npw = pwd.getpwnam(sys.argv[1])\nos.setgid(pw.pw_gid)\nos.setuid(pw.pw_uid)\nos.execvp(sys.argv[2], sys.argv[2:])\n' \
    > /usr/local/bin/su-exec \
    && chmod +x /usr/local/bin/su-exec

# ── Entrypoint (PI variant — no Claude credential copy) ───────────────────────
COPY entrypoint-pi.sh /usr/local/bin/entrypoint-pi.sh
RUN chmod +x /usr/local/bin/entrypoint-pi.sh

WORKDIR /workspace

SHELL ["/bin/bash", "--login", "-c"]
ENTRYPOINT ["/usr/local/bin/entrypoint-pi.sh"]
CMD ["/bin/bash", "--login"]
