# =============================================================================
# Claude Code — Multistage Chainguard Wolfi + Rust tools
# Hardened · Minimal · ARM64 (Apple Silicon / M4)
#
# Stage 1 — builder  : Chainguard Rust dev → compila herramientas Rust
# Stage 2 — runtime  : Chainguard Wolfi   → binarios + glibc + hardened
#
# Base: cgr.dev/chainguard — glibc, CVE-free por diseño, signed, ARM64
#
# Por qué Wolfi en vez de Alpine:
#   Alpine usa musl, cuyo binario claude ≥ 2.1.63 requiere posix_getdents,
#   símbolo exclusivo de glibc que no existe en ninguna versión de musl.
#   Wolfi es glibc-based con footprint comparable a Alpine (~5 MB base).
# =============================================================================


# ── Stage 1: builder ──────────────────────────────────────────────────────────
# Chainguard Rust dev — tiene cargo preinstalado, hardened, ARM64
# Esta imagen NO llega a producción
# ─────────────────────────────────────────────────────────────────────────────
FROM --platform=linux/arm64 cgr.dev/chainguard/rust:latest-dev AS builder

USER root
ENV HOME=/root \
    PATH="/root/.cargo/bin:$PATH"

# Compilar todas las herramientas en un solo RUN para aprovechar cache de capas
RUN cargo install \
        ripgrep \
        fd-find \
        bat \
        eza \
        du-dust \
        procs \
        bottom \
    && rm -rf /root/.cargo/registry /root/.cargo/git


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
# Chainguard Wolfi — hardened, minimal, glibc-based, ARM64
# Sin Rust, sin build tools — imagen mínima
# ─────────────────────────────────────────────────────────────────────────────
FROM --platform=linux/arm64 cgr.dev/chainguard/wolfi-base:latest AS runtime

LABEL maintainer="claude-code-agent" \
      description="Hardened Claude Code agent — Chainguard Wolfi + Rust tools" \
      org.opencontainers.image.base.name="cgr.dev/chainguard/wolfi-base"

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm-256color \
    PATH="/root/.local/bin:/usr/local/bin:$PATH" \
    BAT_PAGER="" \
    BAT_STYLE="numbers,changes,header"

# Dependencias runtime — solo lo necesario, sin dev tools
# Notas de nombres en Wolfi (difieren de Alpine):
#   tar      → no existe standalone; lo provee busybox (/usr/bin/tar)
#   nodejs   → requiere versión explícita (nodejs-22 = LTS actual)
#   python3  → requiere versión explícita (python-3.13 = latest stable)
RUN apk add --no-cache \
        bash \
        busybox \
        curl \
        wget \
        git \
        git-lfs \
        openssh-client \
        ca-certificates \
        jq \
        unzip \
        gzip \
        tmux \
        nodejs-22 \
        npm \
        python-3.13 \
        py3-pip

# Copiar binarios compilados desde el stage builder
COPY --from=builder /root/.cargo/bin/rg     /usr/local/bin/rg
COPY --from=builder /root/.cargo/bin/fd     /usr/local/bin/fd
COPY --from=builder /root/.cargo/bin/bat    /usr/local/bin/bat
COPY --from=builder /root/.cargo/bin/eza    /usr/local/bin/eza
COPY --from=builder /root/.cargo/bin/dust   /usr/local/bin/dust
COPY --from=builder /root/.cargo/bin/procs  /usr/local/bin/procs
COPY --from=builder /root/.cargo/bin/btm    /usr/local/bin/btm

# Claude Code CLI — glibc runtime detectado automáticamente por el instalador
# Descargará claude-linux-arm64 (glibc) en vez del binario musl problemático
RUN curl -fsSL https://claude.ai/install.sh -o /tmp/claude-install.sh \
    && yes | bash /tmp/claude-install.sh \
    && rm -f /tmp/claude-install.sh

# OpenCode — binario precompilado, arquitectura detectada automáticamente
RUN curl -fsSL https://opencode.ai/install | bash \
    && mv /root/.opencode/bin/opencode /usr/local/bin/opencode \
    && chmod 755 /usr/local/bin/opencode \
    && rm -rf /root/.opencode

# Aliases Rust — disponibles en shells interactivas
RUN cat > /etc/profile.d/rust-aliases.sh << 'EOF'
alias grep='rg --smart-case --follow'
alias find='fd --follow'
alias cat='bat --paging=never'
alias ls='eza'
alias ll='eza -la --git'
alias la='eza -la'
alias lt='eza --tree --level=2'
alias du='dust'
alias ps='procs'
alias top='btm'
EOF

RUN echo 'source /etc/profile.d/rust-aliases.sh' >> /root/.bashrc \
    && echo 'source /etc/profile.d/rust-aliases.sh' >> /root/.profile

# Git config base
RUN git config --global init.defaultBranch main \
    && git config --global core.editor "true" \
    && git config --global advice.detachedHead false

# Directorio de trabajo — aquí se monta el volumen del repo
WORKDIR /workspace

SHELL ["/bin/bash", "--login", "-c"]
CMD ["/bin/bash", "--login"]
